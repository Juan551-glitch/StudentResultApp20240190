@page "/student-results"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using StudentResultApp.Data
@using StudentResultApp.Models
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white">
        <h4 class="mb-0">Student Results Dashboard</h4>
    </div>

    <div class="card-body">
        <EditForm Model="student" OnValidSubmit="AddStudentAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="card p-4 shadow-sm">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Student Number</label>
                        <input class="form-control" @bind="student.StudentNumber" maxlength="20" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Full Name</label>
                        <input class="form-control" @bind="student.FullName" maxlength="150" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Module</label>
                        <input class="form-control" @bind="student.Module" maxlength="100" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Mark</label>
                        <input type="number" class="form-control" @bind="student.Mark" min="0" max="100" step="0.01" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary" disabled="@isSaving">Save Student Result</button>
            </div>
        </EditForm>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @statusCssClass" role="alert">@statusMessage</div>
}

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Student No.</th>
            <th>Full Name</th>
            <th>Module</th>
            <th>Mark</th>
            <th>Result</th>
        </tr>
    </thead>
    <tbody>
        @if (students.Count == 0)
        {
            <tr>
                <td colspan="5" class="text-center text-muted">No student results captured yet.</td>
            </tr>
        }
        else
        {
            @foreach (var item in students)
            {
                <tr>
                    <td>@item.StudentNumber</td>
                    <td>@item.FullName</td>
                    <td>@item.Module</td>
                    <td>@item.Mark.ToString("0.00")</td>
                    <td>
                        <span class="badge @(item.Mark >= 50 ? "bg-success" : "bg-danger")">@item.GetResult()</span>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private Student student = new();
    private List<Student> students = new();
    private string? statusMessage;
    private string statusCssClass = "alert-success";
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();
            students = await db.StudentResults
                .AsNoTracking()
                .OrderByDescending(result => result.ResultID)
                .ToListAsync();
        }
        catch (Exception)
        {
            statusCssClass = "alert-danger";
            statusMessage = "Student results could not be loaded. Check the StudentResultsDB connection string in Azure App Service settings.";
        }
    }

    private async Task AddStudentAsync()
    {
        isSaving = true;
        statusMessage = null;

        try
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();
            var result = new Student
            {
                StudentNumber = student.StudentNumber.Trim(),
                FullName = student.FullName.Trim(),
                Module = student.Module.Trim(),
                Mark = student.Mark
            };

            db.StudentResults.Add(result);
            await db.SaveChangesAsync();

            students.Insert(0, result);
            student = new Student();
            statusCssClass = "alert-success";
            statusMessage = "Student result saved successfully.";
        }
        catch (Exception)
        {
            statusCssClass = "alert-danger";
            statusMessage = "The result could not be saved. Check the Azure SQL connection and try again.";
        }
        finally
        {
            isSaving = false;
        }
    }
}
